# Frontend runtime mode:
#   mock — in-browser DEMO adapter (Phase 1), no backend required, nothing persists
#   http — talk to apps/api (Phase 2); requests to /api are proxied to http://localhost:4000 in dev
#   Production builds MUST use http (`npm run build:prod` at the repo root, or the Dockerfile, set it for you).
VITE_API_MODE=mock
# Optional explicit API base URL for http mode (defaults to /api)
VITE_API_BASE_URL=
