# DeoDap SEO Sentinel API — environment variables (Phase 2).
# Copy to .env and fill in. NEVER commit real values. Secrets are read only from the environment:
# they are never stored by the UI, never returned by the API and redacted from logs.
# Storage is TEMPORARY in-memory — all data is lost on restart. No database is configured (Phase 3 awaits authorization).

# ---------------------------------------------------------------- runtime
NODE_ENV=development            # development | test | production
PORT=4000
LOG_LEVEL=info                  # fatal | error | warn | info | debug | trace | silent
# HMAC secret for session tokens, >= 32 chars. REQUIRED in production (a random per-process value is used otherwise).
SESSION_SECRET=
# 0 = signed in until the user signs out (default). A number of hours caps every session.
SESSION_TTL_HOURS=0
CORS_ORIGIN=                    # only needed when the web app is served from another origin (Vite dev proxies /api)
APP_BASE_URL=                   # public URL of the web app incl. any sub-path, e.g. https://apps.deodap.info/seo-tool (links, Shopify OAuth callback, sub-path serving)

# ---------------------------------------------------------------- production hosting
# PostgreSQL: websites, crawls, page results, issues, Health Score inputs, users and settings survive restarts.
# Render: the database's Internal Database URL. Never commit a real value (set it in the hosting platform's secrets).
DATABASE_URL=                   # e.g. postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSL=auto               # auto (no TLS for local / Render-internal hosts, verified TLS otherwise) | require | no-verify | disable
DATABASE_WAIT_SECONDS=60        # how long start-up waits for the database before giving up
# Without DATABASE_URL, NODE_ENV=production refuses to start unless ALLOW_EPHEMERAL_STORAGE=true (all data lost on
# restart). SESSION_SECRET is required in production.
ALLOW_EPHEMERAL_STORAGE=false   # set true only for a staging deployment without a database
ADMIN_EMAIL=                    # first account (Super Admin: every section), created on a clean start when no employees exist
ADMIN_NAME=
ADMIN_INITIAL_PASSWORD=         # >= 10 chars with letters and numbers; change it after the first sign-in
SITE_ADMIN_EMAIL=               # optional Admin account (Overview + SEO operations only), created when no employee has this email
SITE_ADMIN_NAME=
SITE_ADMIN_INITIAL_PASSWORD=    # >= 8 characters; set it only in the server's secret store / .env, never in code
WEB_DIST_DIR=                   # e.g. /app/apps/web/dist — serve the built web app from this server (same origin)
TRUST_PROXY=                    # hops in front of the app; defaults to 1 in production (one platform load balancer)
AUTH_RATE_LIMIT=20              # sign-in / reset attempts per client IP per 15 minutes

# ---------------------------------------------------------------- development switches (forced off in production)
DEV_EXPOSE_RESET_TOKEN=true     # return the reset token in the API response when email is not configured
SCHEDULER_ENABLED=false         # in-process scheduler: crawls, 00:30 IST escalations, 08:00 IST digest, weekly/monthly reports

# ---------------------------------------------------------------- crawler (PDF §2A, §16) — see LOCAL_CRAWLING.md
# Live crawling is OFF by default. Websites added under "Manage websites" get their own crawler restricted to their host.
# Every request is SSRF-checked: localhost, private, link-local and cloud-metadata addresses are always refused
# (redirects included). Crawl jobs and results are kept in memory only and are lost on restart.
# CRAWLER_ALLOW_LIVE=true is the one server-wide switch for live crawling of EVERY registered website. Which hosts may
# be requested is decided per website: each website under "Manage websites" is crawled only on its own registered URL.
# CRAWLER_BASE_URL is the primary website (and the only host the PRIMARY website's crawler may request). Without it the
# primary website cannot be crawled (the Crawl Center says why) but every other registered website still can.
CRAWLER_BASE_URL=               # primary website, e.g. https://deodap.in (added websites use their own URL)
CRAWLER_USER_AGENT=             # OPTIONAL — default "DeoDapSEOSentinel/1.0 (+internal audit)"; allow it in Shopify bot protection
CRAWLER_ALLOW_LIVE=false        # set to true on your server to crawl live websites (then restart the API)
CRAWLER_MAX_PAGES=               # OPTIONAL server-wide page cap; leave empty for no limit (crawl every page)
CRAWLER_REQUEST_DELAY_MS=250    # minimum gap between requests to the site, per crawl
CRAWLER_MAX_BODY_BYTES=5242880  # largest response body read per request (bytes); larger pages are truncated
# Websites always in the website selector (added when missing; never changed or removed). Production default:
# SEED_WEBSITES=DeoDap|https://deodap.in/|shopify,Grabnix|https://grabnix.in/|shopify,Oblivion|https://oblivion.co.in/|shopify,Natation|https://natation.in/|shopify
CRAWLER_MAX_CONCURRENT_JOBS=3   # crawls RUNNING at the same time (all websites); more are queued (batches of up to 11 websites)
# CRAWLER_JOB_RESERVE_MB=90     # memory another crawl needs before it may start next to running ones
# Image Audit: rounds of 10 min until every image is answered (max 12 h); progress stored every 10 s (PostgreSQL with DATABASE_URL).
# IMAGE_AUDIT_BUDGET_MINUTES=10
# IMAGE_AUDIT_MAX_HOURS=12
# IMAGE_AUDIT_CHECKPOINT_SECONDS=10
# IMAGE_AUDIT_RATE_LIMIT_ROUNDS=3
# IMAGE_AUDIT_RATE_LIMIT_PAUSE_SECONDS=60
# IMAGE_AUDIT_REUSE_HOURS=24
# IMAGE_AUDIT_MAX_CONCURRENT=2
# With DATABASE_URL: a crawl interrupted by a restart / redeploy is started again (same settings, from the beginning).
# CRAWLER_RESUME_INTERRUPTED=true
# CRAWLER_RESUME_MAX_ATTEMPTS=2
# While a crawl runs, request this server's own /healthz so an idle-stopping host (Render free plan) does not stop it.
# Uses KEEP_AWAKE_URL, else RENDER_EXTERNAL_URL (set by Render). Off: CRAWL_KEEP_AWAKE=false
# CRAWL_KEEP_AWAKE=true
# KEEP_AWAKE_URL=https://your-service.onrender.com
# KEEP_AWAKE_INTERVAL_SECONDS=300
CRAWLER_RETRIES=2               # retries per request after 429 / 502 / 503 / 504, a timeout or a dropped connection
CRAWLER_MAX_RETRY_WAIT_MS=30000 # longest Retry-After / backoff wait per retry; longer requests are recorded, not waited for
CRAWLER_MAX_CRAWL_DELAY_MS=30000 # highest robots.txt Crawl-delay honoured (larger values are capped)
CRAWLER_MAX_SITEMAP_FILES=1000  # most sitemap files read per crawl (sitemap index files included)
CRAWLER_MAX_SITEMAP_MB=50       # largest sitemap file read, after unzipping .xml.gz (sitemaps.org limit: 50 MB)

# ---------------------------------------------------------------- native crawler (Go) + text core (Rust)
# Built with `npm run build:native` into bin/ (the Docker image builds them too). See LOCAL_CRAWLING.md.
CRAWLER_ENGINE=auto             # auto (Go when installed, else built-in Node crawler) | go | node
CRAWLER_GO_BIN=                 # path to sentinel-crawler(.exe); default: bin/ at the project root
TEXTCORE_BIN=                   # path to sentinel-textcore(.exe); default: bin/ at the project root
CRAWLER_WORK_DIR=               # temporary crawl files (default: the OS temp folder); cleaned after each crawl and at start-up
CRAWLER_MEMORY_BUDGET_MB=       # RSS budget for API + crawler + text core together; default 85% of the container limit
CRAWLER_GO_MEMORY_MB=           # soft memory limit of the Go crawler (default: 35% of the budget, 64–160 MB)
CRAWLER_SMART_MAX_PAGES=10000   # pages a Smart crawl fetches (highest priority first; at most 10000); Full crawls have no page budget
# Image Audit (started from the Image Audit screen, never by a crawl)
IMAGE_AUDIT_MAX_IMAGES=50000    # unique images checked per audit
IMAGE_AUDIT_BUDGET_MINUTES=30   # images left after this are reported as deferred
IMAGE_AUDIT_CONCURRENCY=4       # images checked at once (max 8)
CRAWLER_KEEP_RESULTS=3          # recent crawls whose page rows stay available (temporary files)
CRAWLER_KEEP_WORK_FILES=false   # keep a crawl's raw files for debugging (never in production)
CRAWLER_STALL_MINUTES=20        # stop a crawl as partial (results kept) when nothing was answered for this long
CRAWLER_CHECKS_BUDGET_MINUTES=  # post-crawl checks time budget; default: as long as the page crawl (5–20 min); the rest is "deferred"

# ---------------------------------------------------------------- Change Monitor + page comparisons (docs/CHANGE_MONITOR.md)
CHANGE_MONITOR_ENABLED=true     # compare every crawl with the baseline (the last valid crawl)
# Website sync (Sync Now / Auto Sync): after the first Full or Smart crawl, only new, changed or removed URLs are crawled.
MONITOR_INTERVAL_MINUTES=720    # Auto Sync interval (720 = every 12 hours; 0 = Auto Sync off; needs SCHEDULER_ENABLED=true). On/off per website in the Crawl Center.
MONITOR_MAX_CHECKS=300          # stored pages content-checked per sync (ETag / Last-Modified + SEO fingerprint), least recently checked first
SYNC_MAX_URLS=2000              # URLs crawled per sync at most; the rest are synced next time
CHANGE_SNAPSHOT_DIR=            # default: OS temp folder — LOST on restart/redeploy (Render: point it at a persistent disk)
CHANGE_SNAPSHOT_KEEP=5          # recorded crawls kept (the baseline is always kept)
CHANGE_SNAPSHOT_MAX_AGE_DAYS=90
CHANGE_CAPTURE_ENABLED=true     # screenshots + rendered HTML + CSS/JS in Chromium (needs a browser, like Lighthouse)
CHANGE_CAPTURE_AFTER_CRAWL=     # default on: capture watched pages + changed pages after each crawl
CHANGE_CAPTURE_CHANGED_PAGES=5
CHANGE_CAPTURE_VIEWPORTS=desktop  # desktop, mobile or desktop,mobile
CHANGE_CAPTURE_KEEP=3           # captures per page and viewport
CHANGE_CAPTURE_MAX_PAGES=200
CHANGE_CAPTURE_MAX_HEIGHT=6000  # px; taller pages are cut
CHANGE_CAPTURE_CONCURRENCY=1    # pages at once in the one browser (max 2)
CHANGE_CAPTURE_MIN_FREE_MB=300  # refused (not started) when less memory is free within the budget
CHANGE_CAPTURE_TIMEOUT_MS=45000
CHANGE_CAPTURE_ASSET_HOSTS=cdn.shopify.com

# ---------------------------------------------------------------- Lighthouse / rendered checks (optional)
LIGHTHOUSE_ENABLED=true         # needs Chrome/Chromium on the API server; one run at a time
LIGHTHOUSE_CHROME_PATH=         # default: an installed Chrome / Chromium is found automatically
LIGHTHOUSE_CHROME_FLAGS=        # e.g. --no-sandbox inside a container that runs as a non-root user without user namespaces
LIGHTHOUSE_MIN_FREE_MB=350      # free memory (within the crawl budget) a run needs; refused below it
LIGHTHOUSE_TIMEOUT_MS=120000

# ---------------------------------------------------------------- data connectors (PDF §15)
GSC_SERVICE_ACCOUNT_JSON=       # service-account JSON (single line); add the account as an Owner of the property
GSC_PROPERTY=                   # optional default, e.g. sc-domain:deodap.in — or save it per website in Settings -> Integrations
GA4_SERVICE_ACCOUNT_JSON=
GA4_PROPERTY_ID=                # optional default (numeric) — or save it per website in Settings -> Integrations
GOOGLE_API_KEY=                 # PageSpeed Insights + Chrome UX Report APIs enabled
BACKLINK_PROVIDER=              # ahrefs | semrush
AHREFS_API_TOKEN=
SEMRUSH_API_KEY=
# Shopify SEO editor: connect in Settings -> Shopify with OAuth (SHOPIFY_API_KEY + SHOPIFY_API_SECRET + APP_BASE_URL),
# or give a custom-app token below (primary website only). The token is held in server memory only. See docs/SHOPIFY_SEO_EDITOR.md.
SHOPIFY_API_KEY=                # optional: OAuth client id — or enter it in Settings -> Shopify -> Shopify app credentials
SHOPIFY_API_SECRET=             # optional: OAuth client secret — or enter it in Settings -> Shopify (stored encrypted)
CREDENTIALS_ENCRYPTION_KEY=     # optional (>= 32 chars): key for credentials entered in the app; default derived from SESSION_SECRET
SHOPIFY_SCOPES=                 # default: read_products,write_products,read_content,write_content,read_themes,write_themes,write_files
SHOPIFY_APP_URL=                # public URL for the OAuth redirect (default APP_BASE_URL); callback: <url>/api/shopify/oauth/callback
SHOPIFY_STORE_DOMAIN=           # e.g. deodap.myshopify.com (token fallback below)
SHOPIFY_ADMIN_TOKEN=            # custom-app Admin API token with the scopes above
SHOPIFY_WEBHOOK_SECRET=         # verifies POST /api/webhooks/shopify
SHOPIFY_API_VERSION=2026-07
GBP_OAUTH_CLIENT_ID=
GBP_OAUTH_CLIENT_SECRET=
GBP_OAUTH_REFRESH_TOKEN=        # OAuth user with Manager access (service accounts cannot access GBP)
GBP_LOCATION_ID=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
PERPLEXITY_API_KEY=

# ---------------------------------------------------------------- delivery (PDF §12)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
DIGEST_RECIPIENTS=              # comma-separated emails
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RECIPIENTS=            # comma-separated E.164 numbers
SLACK_WEBHOOK_URL=

# ---------------------------------------------------------------- DeoDap Task Ops (PDF §12.4)
TASK_OPS_BASE_URL=              # no public API documented — payload shape is an assumption until confirmed
TASK_OPS_TOKEN=
