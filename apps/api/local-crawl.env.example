# DeoDap SEO Sentinel: local live-crawling configuration.
# Copy this file to apps/api/.env (it stays on your computer; .env files are never committed or zipped),
# fill in ADMIN_EMAIL and ADMIN_INITIAL_PASSWORD, then start the API with:  npm run dev:api:env
# Full instructions: LOCAL_CRAWLING.md at the project root.
#
# Comments are on their own lines on purpose: older Node 20 releases do not understand comments after a value.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Leave empty for local use: a random secret is generated each time the server starts (you sign in again after a restart).
SESSION_SECRET=

# Clean live start: no DEMO data, so crawl results are never mixed with sample data.
SEED_DEMO_DATA=false

# Your local admin account, created when the server starts. Choose your own values.
# The password needs at least 10 characters with letters and numbers. Never reuse a real password here.
ADMIN_EMAIL=
ADMIN_NAME=Local Admin
ADMIN_INITIAL_PASSWORD=

# The primary website to crawl. Other sites can be added later under Manage websites.
CRAWLER_BASE_URL=https://deodap.in

# Required for any crawl of a real (non-localhost) website. Nothing is crawled until you press Start crawl.
CRAWLER_ALLOW_LIVE=true

# Nothing runs automatically.
SCHEDULER_ENABLED=false

# Politeness and safety. There is NO page limit: "All pages" crawls every page the site has.
# (Optional: add CRAWLER_MAX_PAGES=<number> only if you want a server-wide page cap.)
CRAWLER_REQUEST_DELAY_MS=250
CRAWLER_MAX_BODY_BYTES=5242880
CRAWLER_MAX_CONCURRENT_JOBS=2

# Reliability: retries after 429 / 5xx / timeouts (with backoff and Retry-After), and the robots.txt Crawl-delay cap.
CRAWLER_RETRIES=2
CRAWLER_MAX_RETRY_WAIT_MS=30000
CRAWLER_MAX_CRAWL_DELAY_MS=30000

# Sitemaps: most files read (index files included) and largest file read in MB (after unzipping .xml.gz).
CRAWLER_MAX_SITEMAP_FILES=1000
CRAWLER_MAX_SITEMAP_MB=50
