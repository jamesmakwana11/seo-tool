{
  "name": "@sentinel/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json --noEmit && esbuild src/server.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/server.js --packages=external --alias:@sentinel/shared=../../packages/shared/src/index.ts --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev:env": "tsx watch --env-file=.env src/server.ts",
    "start:env": "node --env-file=.env dist/server.js",
    "start:env:large": "node --max-old-space-size=8192 --env-file=.env dist/server.js"
  },
  "devDependencies": {
    "@types/express": "5.0.0",
    "@types/node": "22.10.2",
    "@types/nodemailer": "6.4.17",
    "@types/supertest": "6.0.2",
    "esbuild": "0.24.2",
    "supertest": "7.0.0",
    "tsx": "4.19.2",
    "vitest": "2.1.9"
  },
  "dependencies": {
    "cheerio": "1.0.0",
    "express": "4.21.2",
    "nodemailer": "6.9.16",
    "pino": "9.5.0",
    "undici": "6.29.0",
    "zod": "3.24.1"
  }
}
