{
  "name": "deodap-seo-sentinel",
  "private": true,
  "version": "0.1.0",
  "description": "DeoDap SEO Sentinel — daily SEO audit, recommendation and task-operations platform (internal).",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @sentinel/web",
    "dev:api": "npm run dev -w @sentinel/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "traceability": "tsx tools/traceability/generate.mjs",
    "build:prod": "npm run build:http -w @sentinel/web && npm run build -w @sentinel/api",
    "start": "node apps/api/dist/server.js",
    "dev:web:http": "npm run dev:http -w @sentinel/web",
    "dev:api:env": "npm run dev:env -w @sentinel/api",
    "start:api:env": "npm run start:env -w @sentinel/api",
    "build:native": "node tools/build-native.mjs",
    "test:native": "node tools/build-native.mjs --test"
  },
  "engines": {
    "node": ">=20.12"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
